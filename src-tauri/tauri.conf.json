{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pigeon",
  "version": "2.0.37",
  "identifier": "com.pigeon.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Pigeon",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "theme": "Dark",
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob: 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost tauri: https: http: ws: wss:; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDQUI2RDU3QjAwMjNFNjMKUldSalBnS3dWMjJyckMxaEpjbEdBbm8wS2RwY0dFU0ZuZDZ0SjA4VUFnME9JbnJ5R2hkRGVRTjUK",
      "endpoints": [
        "https://github.com/kundanlcb/pigeon/releases/latest/download/latest.json"
      ]
    }
  }
}
