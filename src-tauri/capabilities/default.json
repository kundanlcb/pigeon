{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://**"
        },
        {
          "url": "https://**"
        },
        {
          "url": "http://*/**"
        },
        {
          "url": "https://*/**"
        },
        {
          "url": "http://*:*/**"
        },
        {
          "url": "https://*:*/**"
        }
      ]
    },
    "dialog:default",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-watch",
    "fs:allow-unwatch",
    "process:default",
    "core:window:allow-set-theme",
    "core:window:allow-start-dragging"
  ]
}